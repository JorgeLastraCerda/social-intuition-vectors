\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Emotion vectors as directions in activation space (schematic).} Conceptually, an emotion vector starts from a neutral model state~$h$. A prompt that evokes a given emotion, such as fear, pushes the residual stream toward a direction~$\hat  {v}_{\text  {fear}}$, encoded here with its representative $d$-dimensional coordinates. This direction behaves like a commuter who takes the same route to work every day: the attitude, direction, and flow stay the same each time. Across thousands of different prompts that express the same emotion in different words, the model converges on this same direction through its layers, and it produces its output by moving along that direction. After \citet {sofroniew2026emotion}, who call this an emotion vector; we reuse the geometry, not the construct.}}{3}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:emotion_vector}{{1}{3}{\textbf {Emotion vectors as directions in activation space (schematic).} Conceptually, an emotion vector starts from a neutral model state~$h$. A prompt that evokes a given emotion, such as fear, pushes the residual stream toward a direction~$\hat {v}_{\text {fear}}$, encoded here with its representative $d$-dimensional coordinates. This direction behaves like a commuter who takes the same route to work every day: the attitude, direction, and flow stay the same each time. Across thousands of different prompts that express the same emotion in different words, the model converges on this same direction through its layers, and it produces its output by moving along that direction. After \citet {sofroniew2026emotion}, who call this an emotion vector; we reuse the geometry, not the construct}{figure.caption.5}{}}
