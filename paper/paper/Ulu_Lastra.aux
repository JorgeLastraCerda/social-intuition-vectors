\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Model architecture and activation scale for nine checkpoints. $d_\mathrm  {model}$ is the number of activation values carried at each token, or the representation width. Probe layer gives the zero-indexed block used to build the directions and the total blocks; 31/48 means index 31 of a 48-block model. $\bar  {\|h\|}$ is the typical activation size there: for each of 200 stories, token activations are averaged and the resulting vector's length is measured; the table reports the mean of these lengths. This value calibrates steering to each model's own scale, so larger values do not imply better or stronger models. Backend is the tool used to read activations: TL is TransformerLens, Bridge is its Hugging Face Bridge interface, and HF a native Hugging Face backend used for the Qwen3.6 checkpoints that TransformerLens does not yet support. }}{4}{table.caption.11}\protected@file@percent }
\newlabel{tab:models}{{1}{4}{Model architecture and activation scale for nine checkpoints. $d_\mathrm {model}$ is the number of activation values carried at each token, or the representation width. Probe layer gives the zero-indexed block used to build the directions and the total blocks; 31/48 means index 31 of a 48-block model. $\bar {\|h\|}$ is the typical activation size there: for each of 200 stories, token activations are averaged and the resulting vector's length is measured; the table reports the mean of these lengths. This value calibrates steering to each model's own scale, so larger values do not imply better or stronger models. Backend is the tool used to read activations: TL is TransformerLens, Bridge is its Hugging Face Bridge interface, and HF a native Hugging Face backend used for the Qwen3.6 checkpoints that TransformerLens does not yet support}{table.caption.11}{}}
